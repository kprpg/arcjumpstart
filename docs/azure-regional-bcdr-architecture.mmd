flowchart LR
    users[Users on US East Coast] --> fd[Azure Front Door or Traffic Manager]

    fd --> east[Primary: US East 2]
    fd --> secondary[Secondary: Central US or West US 2 or 3]

    subgraph EAST_Stack[US East 2 Primary Stack]
        app1[App Tier]
        data1[Data Tier]
        kv1[Key Vault and Config]
        mon1[Monitoring]
        app1 --> data1
        app1 --> kv1
        app1 --> mon1
    end

    subgraph SECONDARY_Stack[Secondary US Geography Stack]
        app2[Standby App Tier]
        data2[Replicated Data Tier]
        kv2[Secondary Key Vault and Config]
        mon2[Monitoring and Runbooks]
        app2 --> data2
        app2 --> kv2
        app2 --> mon2
    end

    subgraph Control[Neutral Control Artifacts]
        iac[Infrastructure as Code]
        backups[Immutable Backups]
        runbooks[Recovery Runbooks]
        registry[Container Images and Artifacts]
    end

    east --> SECONDARY_Stack
    EAST_Stack --> SECONDARY_Stack
    Control --> EAST_Stack
    Control --> SECONDARY_Stack
