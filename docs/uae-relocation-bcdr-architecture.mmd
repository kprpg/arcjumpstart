flowchart LR
    users[Users in UAE and GCC] --> fd[Azure Front Door or Traffic Manager]

    fd --> uae[Primary: UAE North]
    fd --> eu[Secondary: North Europe or West Europe]

    subgraph UAE_Stack[UAE Primary Stack]
        app1[App Tier]
        data1[Data Tier]
        kv1[Key Vault and Config]
        mon1[Monitoring]
        app1 --> data1
        app1 --> kv1
        app1 --> mon1
    end

    subgraph EU_Stack[Secondary Geography Stack]
        app2[Standby App Tier]
        data2[Replicated Data Tier]
        kv2[Secondary Key Vault and Config]
        mon2[Monitoring and Runbooks]
        app2 --> data2
        app2 --> kv2
        app2 --> mon2
    end

    subgraph Control[Neutral Control Artifacts]
        iac[Infrastructure as Code]
        backups[Immutable Backups]
        runbooks[Recovery Runbooks]
        registry[Container Images and Artifacts]
    end

    uae --> EU_Stack
    UAE_Stack --> EU_Stack
    Control --> UAE_Stack
    Control --> EU_Stack
